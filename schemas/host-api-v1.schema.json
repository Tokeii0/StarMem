{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starmem.dev/schemas/host-api-v1.json",
  "title": "StarMem host API v1 messages",
  "oneOf": [
    {"$ref": "#/$defs/openSessionRequest"},
    {"$ref": "#/$defs/openSessionResponse"},
    {"$ref": "#/$defs/runRequest"},
    {"$ref": "#/$defs/runResponse"},
    {"$ref": "#/$defs/apiError"},
    {"$ref": "#/$defs/progressEvent"},
    {"$ref": "#/$defs/capabilities"}
  ],
  "$defs": {
    "path": {"type": "string"},
    "hostImageOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_path", "auto_discover_sidecars", "decode_cache_bytes", "qevm_layout"],
      "properties": {
        "metadata_path": {"oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "auto_discover_sidecars": {"type": "boolean"},
        "decode_cache_bytes": {"type": "integer", "minimum": 1},
        "qevm_layout": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ram_block", "below_4g_length", "above_4g_physical_base"],
              "properties": {
                "ram_block": {"type": "string", "minLength": 1},
                "below_4g_length": {"type": "integer", "minimum": 0},
                "above_4g_physical_base": {"type": "integer", "minimum": 0}
              }
            }
          ]
        }
      }
    },
    "hostSymbolOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_path", "pdb_path", "cache_root", "search_roots", "allow_compatible_local_symbols"],
      "properties": {
        "profile_path": {"oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "pdb_path": {"oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "cache_root": {"oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "search_roots": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "allow_compatible_local_symbols": {"type": "boolean"}
      }
    },
    "openSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration_api_version", "request_id", "image_path", "platform", "image", "symbols"],
      "properties": {
        "integration_api_version": {"const": 5},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "image_path": {"$ref": "#/$defs/path"},
        "platform": {"enum": ["auto", "windows", "linux"]},
        "image": {"$ref": "#/$defs/hostImageOptions"},
        "symbols": {"$ref": "#/$defs/hostSymbolOptions"}
      }
    },
    "openSessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_api_schema_version", "integration_api_version", "platform", "source_identity", "warnings"],
      "properties": {
        "host_api_schema_version": {"const": 1},
        "integration_api_version": {"const": 5},
        "platform": {"enum": ["windows", "linux"]},
        "source_identity": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "object"}}
      }
    },
    "runRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration_api_version", "request_id", "command_id", "arguments"],
      "properties": {
        "integration_api_version": {"const": 5},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "command_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "arguments": {"type": "object"}
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "media_type", "size", "sha256", "partial"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/path"},
        "media_type": {"type": ["string", "null"]},
        "size": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "partial": {"type": "boolean"}
      }
    },
    "runResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_api_schema_version", "integration_api_version", "request_id", "command_id", "envelope", "artifacts"],
      "properties": {
        "host_api_schema_version": {"const": 1},
        "integration_api_version": {"const": 5},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "command_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "envelope": {
          "type": "object",
          "required": ["schema_version", "command", "available", "complete", "data"]
        },
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactReference"}}
      }
    },
    "apiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_api_schema_version", "integration_api_version", "request_id", "command_id", "code", "message", "retryable", "context"],
      "properties": {
        "host_api_schema_version": {"const": 1},
        "integration_api_version": {"const": 5},
        "request_id": {"type": ["string", "null"]},
        "command_id": {"type": ["string", "null"]},
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "context": {"type": "object"}
      }
    },
    "progressEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_api_schema_version", "integration_api_version", "request_id", "command_id", "phase", "unit", "current", "total", "state"],
      "properties": {
        "host_api_schema_version": {"const": 1},
        "integration_api_version": {"const": 5},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "command_id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "unit": {"enum": ["stages", "items", "bytes"]},
        "current": {"type": "integer", "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0},
        "state": {"enum": ["started", "running", "completed", "cancelled", "failed"]}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_api_schema_version", "integration_api_version", "evidence_schema_version", "raw_object_schema_version", "command_registry_schema_version", "sqlite_schema_version", "version", "build_id", "registered_command_count", "supported_platforms", "runnable_command_ids"],
      "properties": {
        "host_api_schema_version": {"const": 1},
        "integration_api_version": {"const": 5},
        "evidence_schema_version": {"type": "integer", "minimum": 1},
        "raw_object_schema_version": {"type": "integer", "minimum": 1},
        "command_registry_schema_version": {"type": "integer", "minimum": 1},
        "sqlite_schema_version": {"type": "integer", "minimum": 1},
        "version": {"type": "string", "minLength": 1},
        "build_id": {"type": "string", "minLength": 1},
        "registered_command_count": {"type": "integer", "minimum": 1},
        "supported_platforms": {"type": "array", "items": {"enum": ["windows", "linux"]}},
        "runnable_command_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}}
      }
    }
  }
}
