{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starmem.dev/schemas/corpus-v1.json",
  "title": "StarMem cross-tool corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "images", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "suite": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "size_bytes", "target_os", "container"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "target_os": {"enum": ["windows", "linux", "macos", "unknown"]},
          "container": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "notes": {"type": "string"},
          "symbol_identity": {
            "type": "object",
            "required": ["kind", "identifiers"],
            "properties": {
              "kind": {"type": "string"},
              "identifiers": {"type": "object"},
              "required": {"type": "boolean"},
              "notes": {"type": "string"},
              "materials": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["root", "path", "sha256", "size_bytes"],
                  "properties": {
                    "root": {"enum": ["shared", "windows", "linux"]},
                    "path": {"type": "string", "minLength": 1},
                    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                    "size_bytes": {"type": "integer", "minimum": 0}
                  }
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "records_path"],
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}},
        "records_path": {"type": "string"}
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "starmem", "volatility3"],
      "properties": {
        "name": {"type": "string"},
        "starmem": {"type": "string"},
        "volatility3": {"type": "string"},
        "transform": {"enum": ["identity", "int", "lower", "basename_lower", "windows_path", "timestamp_seconds", "bool"]}
      }
    },
    "gate": {
      "type": "object",
      "required": ["path"],
      "anyOf": [
        {"required": ["equals"]},
        {"required": ["min_count"]},
        {"required": ["max_count"]},
        {"required": ["contains"]},
        {"required": ["contains_warning_code"]}
      ],
      "properties": {
        "tool": {"enum": ["starmem", "volatility3"]},
        "path": {"type": "string"},
        "equals": {},
        "min_count": {"type": "integer", "minimum": 0},
        "max_count": {"type": "integer", "minimum": 0},
        "contains": {},
        "contains_warning_code": {"type": "string"}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image", "mode", "starmem", "volatility3", "comparison"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "mode": {"enum": ["exact", "subset", "expected_difference", "expected_failure"]},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "starmem": {"$ref": "#/$defs/tool"},
        "volatility3": {"$ref": "#/$defs/tool"},
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_fields"],
          "properties": {
            "key_fields": {"type": "array", "items": {"$ref": "#/$defs/key"}},
            "subset_side": {"enum": ["starmem", "volatility3"]}
          }
        },
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "starmem": {"type": "array", "items": {"type": "integer"}},
            "volatility3": {"type": "array", "items": {"type": "integer"}}
          }
        },
        "envelope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "starmem": {"$ref": "#/$defs/envelopeRules"},
            "volatility3": {"$ref": "#/$defs/envelopeRules"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "starmem": {"$ref": "#/$defs/resourceLimits"},
            "volatility3": {"$ref": "#/$defs/resourceLimits"}
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "positive": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
            "completeness": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
            "other": {"type": "array", "items": {"$ref": "#/$defs/gate"}}
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "tool": {"enum": ["starmem", "volatility3", "either"]},
            "allow_equal": {"type": "boolean"}
          }
        }
      }
    },
    "envelopeRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "equals": {"type": "object"},
        "warning_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_peak_rss_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
